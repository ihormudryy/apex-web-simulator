{
  "name": "helloracer-webgl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Silverstone GP F1 racer on Three.js \u2014 no build step, ES modules straight from an importmap.",
  "scripts": {
    "test": "node --import ./scripts/test-setup.mjs --test",
    "test:visual": "node scripts/visual-regression.mjs",
    "serve": "python3 server.py",
    "assets": "bash download.sh",
    "validate": "node scripts/validate-physics.mjs",
    "validate:visual": "node scripts/validate-visual.mjs",
    "validate:aa": "node scripts/validate-aa.mjs",
    "validate:drive": "node scripts/validate-drive.mjs"
  }
}
